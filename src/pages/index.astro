---
import articles from '../data/articles.json';

// 検索したくなる戦術・ギミックの候補リスト
const conceptKeywords = [
  'TOD', 'バトン', '受けル', '受けループ', '壁展開', 'ステロ', 'みがまも', 
  '対面', '一撃', 'トリル', '毒菱', '晴れ', '雨', '砂', '雪', '起点', 
  'チョッキ', 'スカーフ', 'ハチマキ', 'メガネ', 'ラム', 'タスキ', '風船', 
  '弱点保険', '呪い', 'あくび', 'イリュージョン', '変態', 'マイナー', '絶対零度'
];

// 記事内に実際に存在するキーワードだけを抽出
const presentKeywords = conceptKeywords.filter(word => {
  return articles.some(article => {
    const text = `${article.title || ''} ${article.text || article.content || ''}`;
    return text.includes(word);
  });
});
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ポケモンチャンピオンズ構築記事検索</title>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-09WNKMPZKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-09WNKMPZKP');
  </script>

  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 24px 16px; line-height: 1.6; color: #1e293b; }
    h1 { font-size: 24px; margin-bottom: 20px; }
    .search-box { display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
    input { padding: 10px 14px; font-size: 16px; border: 1px solid #cbd5e1; border-radius: 6px; flex: 1; min-width: 200px; }
    select { padding: 10px 14px; font-size: 16px; border: 1px solid #cbd5e1; border-radius: 6px; }
    .range-group { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    
    /* トレンドタグ関連スタイル */
    .trends-container { margin-bottom: 20px; font-size: 14px; color: #475569; }
    .trends-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .shuffle-btn { background: none; border: none; color: #2563eb; font-size: 13px; cursor: pointer; text-decoration: underline; padding: 0; }
    .shuffle-btn:hover { color: #1d4ed8; }
    .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .tag-btn { background-color: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 16px; padding: 4px 12px; font-size: 13px; color: #334155; cursor: pointer; transition: all 0.2s; }
    .tag-btn:hover { background-color: #2563eb; color: #ffffff; border-color: #2563eb; }

    .card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 12px; background-color: #fff; }
    .card h3 { margin: 0 0 8px 0; font-size: 18px; }
    .card a { color: #2563eb; text-decoration: none; }
    .card a:hover { text-decoration: underline; }
    .meta { font-size: 14px; color: #64748b; margin-bottom: 8px; }
    .snippet { font-size: 14px; color: #334155; }

    .season-badge {
      font-weight: bold;
      color: #0f172a;
      background-color: #e2e8f0;
      padding: 3px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 6px;
      font-size: 14px;
    }

    mark { background-color: #fef08a; font-weight: bold; color: #0f172a; padding: 0 2px; border-radius: 2px; }
  </style>
</head>
<body>
  <h1>ポケモンチャンピオンズ構築記事検索</h1>

  <div class="search-box">
    <input type="text" id="query" placeholder="キーワードを入力 (例: 害悪)" />
    
    <!-- シーズン範囲選択 -->
    <div class="range-group">
      <select id="season-start">
        <option value="">開始シーズン</option>
      </select>
      <span>〜</span>
      <select id="season-end">
        <option value="">終了シーズン</option>
      </select>
    </div>
  </div>

  <!-- 動的ギミックタグ表示 -->
  <div class="trends-container">
    <div class="trends-header">
      <strong>🎲 気になる戦術・ギミックで検索:</strong>
      <button type="button" id="shuffle-btn" class="shuffle-btn">🔄 他のキーワード</button>
    </div>
    <div id="tag-list" class="tag-list"></div>
  </div>

  <div id="results-count" style="margin-bottom: 12px; color: #64748b; font-size: 14px;"></div>
  <div id="results"></div>

  <script is:inline define:vars={{ articles, presentKeywords }}>
    const queryInput = document.getElementById('query');
    const startSelect = document.getElementById('season-start');
    const endSelect = document.getElementById('season-end');
    const resultsDiv = document.getElementById('results');
    const countDiv = document.getElementById('results-count');
    const tagListDiv = document.getElementById('tag-list');
    const shuffleBtn = document.getElementById('shuffle-btn');

    const rawSeasons = [...new Set(articles.map(a => a.season))].filter(Boolean);
    const sortedSeasons = rawSeasons.sort((a, b) => {
      return String(a).localeCompare(String(b), undefined, { numeric: true });
    });

    sortedSeasons.forEach(s => {
      const opt1 = document.createElement('option');
      opt1.value = s;
      opt1.textContent = `シーズン ${s}`;
      startSelect.appendChild(opt1);

      const opt2 = document.createElement('option');
      opt2.value = s;
      opt2.textContent = `シーズン ${s}`;
      endSelect.appendChild(opt2);
    });

    // キーワードをクライアント側でランダム抽出・描画する関数
    function renderTags() {
      const shuffled = [...presentKeywords].sort(() => Math.random() - 0.5);
      const selected = shuffled.slice(0, 10);

      tagListDiv.innerHTML = selected.map(word => `
        <button type="button" class="tag-btn" data-word="${word}">#${word}</button>
      `).join('');

      tagListDiv.querySelectorAll('.tag-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          queryInput.value = btn.dataset.word;
          render();
        });
      });
    }

    function highlightText(text, keyword) {
      if (!text) return '';
      if (!keyword) return text;
      const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    function render() {
      const q = queryInput.value.trim().toLowerCase();
      const startVal = startSelect.value;
      const endVal = endSelect.value;

      const startIndex = startVal ? sortedSeasons.indexOf(startVal) : 0;
      const endIndex = endVal ? sortedSeasons.indexOf(endVal) : sortedSeasons.length - 1;

      const filtered = articles.filter(item => {
        const textContent = item.text || item.content || '';
        const matchQuery = !q || 
          (item.title && item.title.toLowerCase().includes(q)) || 
          (textContent && textContent.toLowerCase().includes(q));

        const itemSeasonIndex = sortedSeasons.indexOf(item.season);
        let matchSeason = true;
        if (startVal || endVal) {
          if (itemSeasonIndex !== -1) {
            const minIdx = Math.min(startIndex, endIndex);
            const maxIdx = Math.max(startIndex, endIndex);
            matchSeason = itemSeasonIndex >= minIdx && itemSeasonIndex <= maxIdx;
          }
        }

        return matchQuery && matchSeason;
      });

      countDiv.textContent = `該当件数: ${filtered.length} 件`;

      resultsDiv.innerHTML = filtered.slice(0, 50).map(item => {
        const highlightedTitle = highlightText(item.title || '', q);

        let snippet = item.text || item.content || '';
        if (q && snippet.toLowerCase().includes(q)) {
          const idx = snippet.toLowerCase().indexOf(q);
          const start = Math.max(0, idx - 40);
          const end = Math.min(snippet.length, idx + 100);
          snippet = (start > 0 ? '...' : '') + snippet.slice(start, end) + (end < snippet.length ? '...' : '');
        } else {
          snippet = snippet.slice(0, 120) + (snippet.length > 120 ? '...' : '');
        }
        const highlightedSnippet = highlightText(snippet, q);

        return `
          <div class="card">
            <h3><a href="${item.url}" target="_blank" rel="noopener noreferrer">${highlightedTitle}</a></h3>
            <div class="meta"><strong class="season-badge">シーズン ${item.season || '不明'}</strong></div>
            <div class="snippet">${highlightedSnippet}</div>
          </div>
        `;
      }).join('');
    }

    shuffleBtn.addEventListener('click', renderTags);
    queryInput.addEventListener('input', render);
    startSelect.addEventListener('change', render);
    endSelect.addEventListener('change', render);

    renderTags();
    render();
  </script>
</body>
</html>