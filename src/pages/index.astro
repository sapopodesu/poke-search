---
import articles from '../data/articles.json';
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ポケモンチャンピオンズ構築記事検索</title>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-09WNKMPZKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-09WNKMPZKP');
  </script>

  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 24px 16px; line-height: 1.6; color: #1e293b; }
    h1 { font-size: 24px; margin-bottom: 20px; }
    .search-box { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }
    input { padding: 10px 14px; font-size: 16px; border: 1px solid #cbd5e1; border-radius: 6px; flex: 1; min-width: 200px; }
    .card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 12px; background-color: #fff; }
    .card h3 { margin: 0 0 8px 0; font-size: 18px; }
    .card a { color: #2563eb; text-decoration: none; }
    .card a:hover { text-decoration: underline; }
    .meta { font-size: 14px; color: #64748b; margin-bottom: 8px; }
    .snippet { font-size: 14px; color: #334155; }

    /* シーズン表記の強調スタイル */
    .season-badge {
      font-weight: bold;
      color: #0f172a;
      background-color: #e2e8f0;
      padding: 3px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 6px;
      font-size: 14px;
    }

    /* 検索ワードの太字＆ハイライト表示 */
    mark { background-color: #fef08a; font-weight: bold; color: #0f172a; padding: 0 2px; border-radius: 2px; }
  </style>
</head>
<body>
  <h1>ポケモンチャンピオンズ構築記事検索</h1>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="検索ワードを入力（例：サーナイト、オーガポン）" />
  </div>

  <div id="resultCount" style="margin-bottom: 16px; font-weight: bold; color: #64748b;"></div>

  <div id="articlesList">
    {articles.map((article) => (
      <div class="card" data-title={article.title} data-content={article.content} data-season={article.season}>
        <h3>
          <a href={article.url} target="_blank" rel="noopener noreferrer">
            <span class="article-title">{article.title}</span>
          </a>
        </h3>
        <div class="meta">
          <strong class="season-badge">{article.season}</strong>
        </div>
        <p class="snippet article-content">{article.content}</p>
      </div>
    ))}
  </div>

  <script is:inline>
    const searchInput = document.getElementById('searchInput');
    const cards = document.querySelectorAll('.card');
    const resultCount = document.getElementById('resultCount');

    function filterArticles() {
      const keyword = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach(card => {
        const titleEl = card.querySelector('.article-title');
        const contentEl = card.querySelector('.article-content');
        const rawTitle = card.dataset.title;
        const rawContent = card.dataset.content;

        const matchesKeyword = !keyword || rawTitle.toLowerCase().includes(keyword) || rawContent.toLowerCase().includes(keyword);

        if (matchesKeyword) {
          card.style.display = 'block';
          visibleCount++;

          if (keyword) {
            const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const regex = new RegExp(`(${escaped})`, 'gi');
            titleEl.innerHTML = rawTitle.replace(regex, '<mark>$1</mark>');
            contentEl.innerHTML = rawContent.replace(regex, '<mark>$1</mark>');
          } else {
            titleEl.textContent = rawTitle;
            contentEl.textContent = rawContent;
          }
        } else {
          card.style.display = 'none';
        }
      });

      resultCount.textContent = `該当件数: ${visibleCount} 件`;
    }

    searchInput.addEventListener('input', filterArticles);
    filterArticles();
  </script>
</body>
</html>